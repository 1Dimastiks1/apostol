FACEBOOK_PAGE_ID=100059029128700
FACEBOOK_PAGE_ACCESS_TOKEN=

# Optional: only configure this if Meta has granted this app access to the rector's profile.
FACEBOOK_RECTOR_PROFILE_ID=
FACEBOOK_RECTOR_USER_ACCESS_TOKEN=

META_GRAPH_API_VERSION=v26.0
FACEBOOK_CONTENT_RETENTION_DAYS=14
FACEBOOK_SYNC_INTERVAL_MS=60000

# Головний адміністратор (/admin): ефіри, події та заявки
ADMIN_PASSWORD=

# Другий адміністратор (/admin): лише перегляд заявок з форми
FORMS_PASSWORD=

# Довільний довгий рядок для підпису сесій (рекомендовано)
SESSION_SECRET=

# Нестандартні адреси адмінки (латиниця, цифри, - і _; від 5 символів). Задані, замість /admin.
# Приклад: ADMIN_PATH=vkhid-k3x9q2 → https://ваш-домен/vkhid-k3x9q2. Задавайте до збірки (на Vercel: у змінних проєкту й Redeploy).
ADMIN_PATH=
# Окрема, легша адреса для адміністратора заявок і записок (необов'язково), наприклад zayavky
FORMS_PATH=


# Адреса сайту для SEO (canonical, Open Graph, sitemap.xml), наприклад https://petropavlivska.church
SITE_URL=
